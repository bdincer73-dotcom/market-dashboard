<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Market Dashboard — {{ run_date }} ({{ run_type|capitalize }})</title>
<style>
  :root {
    --green: #1e8e3e; --amber: #e8a33d; --red: #d93025; --yellow: #e0c33d;
    --bg: #0f1115; --card: #171a21; --text: #e8e9ec; --muted: #9aa0ac; --border: #2a2e38;
  }
  * { box-sizing: border-box; }
  body { margin:0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
         background: var(--bg); color: var(--text); padding: 24px; }
  .wrap { max-width: 1000px; margin: 0 auto; }
  header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:8px; }
  .analyzer-link { display:inline-flex; align-items:center; gap:5px; padding:6px 14px; border-radius:999px;
    font-weight:700; font-size:0.85rem; background: rgba(30,142,62,0.12); color: var(--green);
    border:1px solid var(--green); text-decoration:none; }
  .analyzer-link:hover { background: rgba(30,142,62,0.22); }
  h1 { font-size: 1.4rem; margin: 0; }
  .sub { color: var(--muted); font-size: 0.85rem; }
  .badge { display:inline-block; padding: 6px 16px; border-radius: 999px; font-weight:700; font-size:0.95rem; }
  .badge.GREEN { background: rgba(30,142,62,0.18); color: var(--green); border:1px solid var(--green); }
  .badge.AMBER { background: rgba(232,163,61,0.18); color: var(--amber); border:1px solid var(--amber); }
  .badge.RED   { background: rgba(217,48,37,0.18); color: var(--red); border:1px solid var(--red); }
  .badge.Bearish     { background: rgba(217,48,37,0.18); color: var(--red); border:1px solid var(--red); }
  .badge.Cautionary  { background: rgba(232,163,61,0.18); color: var(--amber); border:1px solid var(--amber); }
  .badge.Watch       { background: rgba(224,195,61,0.18); color: var(--yellow); border:1px solid var(--yellow); }
  .badge.Constructive{ background: rgba(30,142,62,0.18); color: var(--green); border:1px solid var(--green); }
  .badge.fomo-green    { background: rgba(30,142,62,0.18); color: var(--green); border:1px solid var(--green); }
  .badge.fomo-building { background: rgba(224,195,61,0.18); color: var(--yellow); border:1px solid var(--yellow); }
  .badge.fomo-elevated { background: rgba(232,163,61,0.18); color: var(--amber); border:1px solid var(--amber); }
  .badge.fomo-reduce   { background: rgba(217,48,37,0.18); color: var(--red); border:1px solid var(--red); }
  .badge.fedliq-expanding   { background: rgba(30,142,62,0.18); color: var(--green); border:1px solid var(--green); }
  .badge.fedliq-neutral     { background: rgba(154,160,172,0.18); color: var(--muted); border:1px solid var(--border); }
  .badge.fedliq-contracting { background: rgba(232,163,61,0.18); color: var(--amber); border:1px solid var(--amber); }
  .fomo-axes { display:grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap:12px; margin-bottom:12px; }
  .fomo-axis { background: rgba(255,255,255,0.03); border:1px solid var(--border); border-radius:8px; padding:10px 12px; }
  .fomo-axis .label { display:flex; justify-content:space-between; font-size:0.8rem; color:var(--muted); margin-bottom:6px; }
  .fomo-axis .label b { color:var(--text); font-weight:600; }
  .fomo-axis .bar-track { background: var(--border); border-radius:999px; height:8px; overflow:hidden; }
  .fomo-axis .bar-fill { height:100%; border-radius:999px; }
  .fomo-action { font-size:0.85rem; padding:10px 12px; border-radius:8px; margin-top:8px;
    background: rgba(255,255,255,0.03); border:1px solid var(--border); }
  .news-ticker { margin-bottom: 14px; }
  .news-ticker:last-child { margin-bottom: 0; }
  .news-ticker .ticker-label { font-weight:700; font-size:0.85rem; margin-bottom:4px; }
  .news-ticker .ticker-label .unavail { color: var(--muted); font-weight:400; font-size:0.75rem; }
  .headline { font-size:0.83rem; padding:3px 0; }
  .headline a { color: var(--text); text-decoration:none; }
  .headline a:hover { text-decoration:underline; }
  .headline .src { color: var(--muted); font-size:0.72rem; margin-left:4px; }
  .news-cols { column-count: 2; column-gap: 24px; }
  @media (max-width: 700px) { .news-cols { column-count: 1; } }
  .news-ticker { break-inside: avoid; }
  .status-pill { font-size: 0.7rem; padding: 2px 8px; border-radius: 999px; font-weight:600; }
  .status-pill.LIVE, .status-pill.EOD { background: rgba(30,142,62,0.15); color: var(--green); }
  .status-pill.STALE { background: rgba(232,163,61,0.15); color: var(--amber); }
  .status-pill.FAILED { background: rgba(217,48,37,0.15); color: var(--red); }
  .grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap:16px; margin-bottom:24px; }
  .card { background: var(--card); border:1px solid var(--border); border-radius:10px; padding:16px; }
  .card h2 { font-size:0.95rem; margin:0 0 10px 0; display:flex; justify-content:space-between; align-items:center; }
  .metric { display:flex; justify-content:space-between; flex-wrap:wrap; gap:4px 12px; padding:4px 0;
    font-size:0.88rem; border-bottom:1px dashed var(--border); }
  .metric:last-child { border-bottom:none; }
  .metric .v { font-weight:600; text-align:right; }
  .bear-grid { grid-template-columns: repeat(auto-fit, minmax(300px,1fr)) !important; }
  table { width:100%; border-collapse: collapse; font-size:0.85rem; }
  th, td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--border); }
  th { color: var(--muted); font-weight:600; }
  .pos { color: var(--green); } .neg { color: var(--red); }
  ul.reasons { margin:0; padding-left:18px; font-size:0.85rem; color: var(--muted); }
  ul.reasons li { margin-bottom:4px; }
  footer { border-top:1px solid var(--border); padding-top:16px; margin-top:8px; }
  footer h2 { font-size:0.85rem; color: var(--muted); margin-bottom:10px; }
  .health-row { display:flex; justify-content:space-between; font-size:0.8rem; padding:4px 0; color: var(--muted); }
  .notes { font-size:0.75rem; color: var(--muted); margin-top:2px; }
  details.legend { margin-bottom:20px; border:1px solid var(--border); border-radius:10px; background: var(--card); }
  details.legend summary { cursor:pointer; padding:10px 16px; font-size:0.85rem; font-weight:600; list-style:none; }
  details.legend summary::-webkit-details-marker { display:none; }
  details.legend summary::before { content: "▸ "; color: var(--muted); }
  details.legend[open] summary::before { content: "▾ "; }
  .legend-body { padding: 0 16px 16px 16px; }
  .legend-group { margin-bottom:14px; }
  .legend-group:last-child { margin-bottom:0; }
  .legend-group h3 { font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em; color: var(--muted); margin:0 0 8px 0; font-weight:600; }
  .legend-row { display:flex; align-items:baseline; gap:8px; font-size:0.82rem; padding:3px 0; }
  .legend-row .badge, .legend-row .status-pill { flex-shrink:0; }
  .legend-row .desc { color: var(--muted); }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>Daily + Weekly Market Dashboard</h1>
      <div class="sub">{{ run_type|capitalize }} run · {{ run_date }} · generated {{ generated_at }}</div>
    </div>
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <a href="analyzer.html" class="analyzer-link">🔒 Portfolio Analyzer</a>
      <div class="badge {{ regime }}">{{ regime }} {{ regime_label }}</div>
    </div>
  </header>

  <div class="sub" style="margin-bottom:16px;">
    Upload your tracker file to the Portfolio Analyzer above for assignment risk and sector-concentration
    checks against your actual positions — it runs entirely in your browser, nothing is ever stored on this site.
  </div>

  <details class="legend" open>
    <summary>Legend — what the colors mean</summary>
    <div class="legend-body">
      <div class="legend-group">
        <h3>Regime call (top badge + "Why this regime")</h3>
        <div class="legend-row"><span class="badge GREEN">GREEN</span><span class="desc">normal risk — breadth stable/rising, RSP confirming, VIX calm, leadership broad. No rule tripped.</span></div>
        <div class="legend-row"><span class="badge AMBER">AMBER</span><span class="desc">selective — at least one warning rule tripped (mixed breadth, rising VIX, narrow leadership, or missing data). Trade smaller, demand a better discount, favor cleaner liquidity.</span></div>
        <div class="legend-row"><span class="badge RED">RED</span><span class="desc">protect cash — breadth deteriorating, RSP underperforming, or volatility/term-structure stress. Default to cash over new risk.</span></div>
      </div>
      <div class="legend-group">
        <h3>Bear Indicator (weekly only, separate 0-8 score)</h3>
        <div class="legend-row"><span class="badge Constructive">🟢 Constructive</span><span class="desc">0-1 of 8 bearish conditions tripped</span></div>
        <div class="legend-row"><span class="badge Watch">🟡 Watch</span><span class="desc">2-3 of 8 tripped</span></div>
        <div class="legend-row"><span class="badge Cautionary">🟠 Cautionary</span><span class="desc">4-5 of 8 tripped</span></div>
        <div class="legend-row"><span class="badge Bearish">🔴 Bearish</span><span class="desc">6-8 of 8 tripped</span></div>
        <div class="notes" style="margin-top:6px;">CMF (Chaikin Money Flow) is a -1 to +1 oscillator, not a percentage — positive means net buying pressure, negative means net selling. It's a different kind of metric from the % stats next to it (breadth, Net New Hi%), which measure share of market.</div>
      </div>
      <div class="legend-group">
        <h3>FOMO Fragility Index (weekly only, euphoria/top companion to the Bear Indicator)</h3>
        <div class="legend-row"><span class="badge fomo-green">🟢 No euphoria</span><span class="desc">composite &lt; 40</span></div>
        <div class="legend-row"><span class="badge fomo-building">🟡 Building</span><span class="desc">composite 40-59</span></div>
        <div class="legend-row"><span class="badge fomo-elevated">🟠 Elevated FOMO</span><span class="desc">composite 60-74</span></div>
        <div class="legend-row"><span class="badge fomo-reduce">🔴 REDUCE — fragile top</span><span class="desc">composite ≥ 75 AND at least 2 of the 3 axes individually above 70</span></div>
        <div class="notes" style="margin-top:6px;">Three axes — Stretch (price over-extension), Leverage (margin debt + suppressed vol), Crowding (concentration + correlation) — combine into a 0-100 composite. RED requires the conjunction of a high composite AND multiple hot axes at once: "expensive but stable" alone won't trigger it, by design.</div>
      </div>
      <div class="legend-group">
        <h3>Fed Liquidity Indicator (weekly only, macro overlay for CSP sizing)</h3>
        <div class="legend-row"><span class="badge fedliq-expanding">🟢 EXPANDING</span><span class="desc">Liquidity Score ≥ 60</span></div>
        <div class="legend-row"><span class="badge fedliq-neutral">⚪ NEUTRAL</span><span class="desc">Liquidity Score 40-59</span></div>
        <div class="legend-row"><span class="badge fedliq-contracting">🟠🔴 CONTRACTING</span><span class="desc">Liquidity Score ≤ 40 (🔴 below 20)</span></div>
        <div class="notes" style="margin-top:6px;">Net Liquidity = Fed total assets − Treasury General Account − ON RRP, a widely used but unofficial proxy. Score starts at 50 and moves with this week's Net Liquidity change, the 4-week trend, and bank reserves' own 4-week move (when available) — see <code>config/thresholds.yaml</code> for the exact weights. Independent of breadth/technicals: a Contracting reading can justify smaller/safer CSP sizing even when the regime call above looks fine.</div>
      </div>
      <div class="legend-group">
        <h3>Data freshness (next to every tile, and in the footer)</h3>
        <div class="legend-row"><span class="status-pill LIVE">LIVE / EOD</span><span class="desc">fresh, usable data for this run</span></div>
        <div class="legend-row"><span class="status-pill STALE">STALE</span><span class="desc">retrieved, but older than expected for this run</span></div>
        <div class="legend-row"><span class="status-pill FAILED">FAILED</span><span class="desc">could not be retrieved this run — shown honestly rather than guessed or carried forward</span></div>
      </div>
      <div class="notes">All regime/Bear Indicator thresholds are tunable in <code>config/thresholds.yaml</code> — edit that file, not the code, to make the dashboard more or less sensitive.</div>
    </div>
  </details>

  {% if bear_indicator is not none %}
  <div class="card" style="margin-bottom:24px;">
    <h2>Bear Indicator (weekly) <span class="status-pill {{ bear_indicator.status }}">{{ bear_indicator.status }}</span>
      {% if bear_indicator.status != 'FAILED' %}
      <span class="badge {{ bear_signal }}">{{ bear_icon }} {{ bear_signal }} — {{ bear_score }}/8</span>
      {% else %}
      <span class="status-pill FAILED">FAILED</span>
      {% endif %}
    </h2>
    <div class="notes" style="margin-bottom:8px;">
      As of {{ bear_as_of }}{% if bear_indicator.status == 'STALE' %} — carried forward from the last Saturday run; recomputes weekly{% else %} — computed fresh this run{% endif %}.
    </div>
    {% if bear_indicator.status != 'FAILED' %}
    <div class="grid bear-grid" style="margin-bottom:12px;">
      {% for t in ['SPY','VOO','IWV','QQQ','RSP'] %}
        {% if bear_indicator.payload.cmf[t] is defined %}
        <div class="metric"><span>{{ t }} CMF(20)</span><span class="v">{{ bear_indicator.payload.cmf[t] }} <span style="color:var(--muted); font-weight:400; font-size:0.75rem;">/ ±1</span></span></div>
        {% endif %}
      {% endfor %}
      <div class="metric"><span>SPY vs 20/50 SMA</span><span class="v">{{ bear_indicator.payload.spy_vs_ma }}</span></div>
      <div class="metric"><span>RSP vs 20/50 SMA</span><span class="v">{{ bear_indicator.payload.rsp_vs_ma }}</span></div>
      <div class="metric"><span>% above 50D / 200D</span><span class="v">{{ bear_indicator.payload.pct_above_50 }}% / {{ bear_indicator.payload.pct_above_200 }}%</span></div>
      <div class="metric"><span>Net New Hi %</span><span class="v">{{ bear_indicator.payload.net_new_high_pct }}%</span></div>
    </div>
    <ul class="reasons">
      {% for r in bear_reasons %}<li>{{ r }}</li>{% endfor %}
    </ul>
    <div class="notes" style="margin-top:8px;">Ported from your Options P&amp;L Tracker's Bear Indicator tab (original 8-condition composite formula).</div>
    {% else %}
    <div class="notes">{{ bear_indicator.notes }}</div>
    {% endif %}
  </div>
  {% endif %}

  {% if fomo_indicator is not none %}
  <div class="card" style="margin-bottom:24px;">
    <h2>FOMO Fragility Index (weekly) <span class="status-pill {{ fomo_indicator.status }}">{{ fomo_indicator.status }}</span>
      {% if fomo_indicator.status != 'FAILED' %}
      <span class="badge fomo-{{ fomo_band }}">{{ fomo_signal }} — {{ fomo_calc.score }}/100</span>
      {% else %}
      <span class="status-pill FAILED">FAILED</span>
      {% endif %}
    </h2>
    <div class="notes" style="margin-bottom:8px;">
      As of {{ fomo_as_of }}{% if fomo_indicator.status == 'STALE' %} — carried forward from the last Saturday run; recomputes weekly{% else %} — computed fresh this run{% endif %}.
      Euphoria/top companion to the Bear Indicator above — catches a levered, crowded, over-extended market, not a downtrend.
    </div>
    {% if fomo_indicator.status != 'FAILED' %}
    <div class="fomo-axes">
      <div class="fomo-axis">
        <div class="label"><span>Stretch <span style="opacity:0.6;">(35%)</span></span><b>{{ fomo_calc.axis_stretch }}/100</b></div>
        <div class="bar-track"><div class="bar-fill" style="width:{{ fomo_calc.axis_stretch }}%; background:var(--red);"></div></div>
      </div>
      <div class="fomo-axis">
        <div class="label"><span>Leverage <span style="opacity:0.6;">(40%)</span></span><b>{{ fomo_calc.axis_leverage }}/100</b></div>
        <div class="bar-track"><div class="bar-fill" style="width:{{ fomo_calc.axis_leverage }}%; background:var(--red);"></div></div>
      </div>
      <div class="fomo-axis">
        <div class="label"><span>Crowding <span style="opacity:0.6;">(25%)</span></span><b>{{ fomo_calc.axis_crowding }}/100</b></div>
        <div class="bar-track"><div class="bar-fill" style="width:{{ fomo_calc.axis_crowding }}%; background:var(--red);"></div></div>
      </div>
    </div>
    <ul class="reasons">
      {% for r in fomo_reasons %}<li>{{ r }}</li>{% endfor %}
    </ul>
    <div class="fomo-action"><b>Action:</b> {{ fomo_calc.action }}</div>
    <div class="notes" style="margin-top:8px;">{{ fomo_indicator.notes }}</div>
    {% else %}
    <div class="notes">{{ fomo_indicator.notes }}</div>
    {% endif %}
  </div>
  {% endif %}

  {% if fed_liquidity is not none %}
  <div class="card" style="margin-bottom:24px;">
    <h2>Fed Liquidity Indicator (weekly) <span class="status-pill {{ fed_liquidity.status }}">{{ fed_liquidity.status }}</span>
      {% if fed_liquidity.status != 'FAILED' %}
      <span class="badge fedliq-{{ fedliq_regime|lower }}">{{ fedliq_regime|upper }} — {{ fedliq_score }}/100</span>
      {% endif %}
    </h2>
    <div class="notes" style="margin-bottom:8px;">
      As of {{ fedliq_as_of }}{% if fed_liquidity.status == 'STALE' %} — carried forward from the last Saturday run; recomputes weekly{% else %} — computed fresh this run{% endif %}.
      Macro overlay for CSP sizing — independent of breadth/technicals; a Contracting reading can justify smaller/safer sizing even when the regime call above looks fine.
    </div>
    {% if fed_liquidity.status != 'FAILED' %}
    <table style="margin-bottom:12px;">
      <tr><th>Component</th><th>Latest</th><th>1-week move</th><th>4-week move</th></tr>
      <tr>
        <td>Fed balance sheet</td>
        <td>${{ '%.3f'|format(fed_liquidity.payload.fed_assets_bn/1000) }}T</td>
        <td class="{{ 'pos' if fed_liquidity.payload.fed_assets_change_1w_bn and fed_liquidity.payload.fed_assets_change_1w_bn > 0 else 'neg' }}">{{ '%+.1f'|format(fed_liquidity.payload.fed_assets_change_1w_bn) if fed_liquidity.payload.fed_assets_change_1w_bn is not none else '—' }}B</td>
        <td>{{ '%+.1f'|format(fed_liquidity.payload.fed_assets_change_4w_bn) if fed_liquidity.payload.fed_assets_change_4w_bn is not none else '—' }}B</td>
      </tr>
      <tr>
        <td>Treasury General Account</td>
        <td>${{ '%.1f'|format(fed_liquidity.payload.tga_bn) }}B</td>
        <td class="{{ 'neg' if fed_liquidity.payload.tga_change_1w_bn and fed_liquidity.payload.tga_change_1w_bn > 0 else 'pos' }}">{{ '%+.1f'|format(fed_liquidity.payload.tga_change_1w_bn) if fed_liquidity.payload.tga_change_1w_bn is not none else '—' }}B</td>
        <td>{{ '%+.1f'|format(fed_liquidity.payload.tga_change_4w_bn) if fed_liquidity.payload.tga_change_4w_bn is not none else '—' }}B</td>
      </tr>
      <tr>
        <td>ON RRP</td>
        <td>${{ '%.1f'|format(fed_liquidity.payload.rrp_bn) }}B</td>
        <td class="{{ 'neg' if fed_liquidity.payload.rrp_change_1w_bn and fed_liquidity.payload.rrp_change_1w_bn > 0 else 'pos' }}">{{ '%+.1f'|format(fed_liquidity.payload.rrp_change_1w_bn) if fed_liquidity.payload.rrp_change_1w_bn is not none else '—' }}B</td>
        <td>—</td>
      </tr>
      <tr>
        <td>Bank reserves</td>
        {% if fed_liquidity.payload.reserves_bn is not none %}
        <td>${{ '%.3f'|format(fed_liquidity.payload.reserves_bn/1000) }}T</td>
        <td class="{{ 'pos' if fed_liquidity.payload.reserves_change_1w_bn and fed_liquidity.payload.reserves_change_1w_bn > 0 else 'neg' }}">{{ '%+.1f'|format(fed_liquidity.payload.reserves_change_1w_bn) if fed_liquidity.payload.reserves_change_1w_bn is not none else '—' }}B</td>
        <td>{{ '%+.1f'|format(fed_liquidity.payload.reserves_change_4w_bn) if fed_liquidity.payload.reserves_change_4w_bn is not none else '—' }}B</td>
        {% else %}
        <td colspan="3">not available this run</td>
        {% endif %}
      </tr>
      <tr>
        <td><b>Net Liquidity</b></td>
        <td><b>${{ '%.3f'|format(fed_liquidity.payload.net_liquidity_bn/1000) }}T</b></td>
        <td class="{{ 'pos' if fed_liquidity.payload.net_liquidity_change_1w_bn and fed_liquidity.payload.net_liquidity_change_1w_bn > 0 else 'neg' }}"><b>{{ '%+.1f'|format(fed_liquidity.payload.net_liquidity_change_1w_bn) if fed_liquidity.payload.net_liquidity_change_1w_bn is not none else '—' }}B</b></td>
        <td class="{{ 'pos' if fed_liquidity.payload.net_liquidity_change_4w_bn and fed_liquidity.payload.net_liquidity_change_4w_bn > 0 else 'neg' }}"><b>{{ '%+.1f'|format(fed_liquidity.payload.net_liquidity_change_4w_bn) if fed_liquidity.payload.net_liquidity_change_4w_bn is not none else '—' }}B</b></td>
      </tr>
    </table>
    {% if fed_liquidity.payload.trend_5w %}
    <div class="notes" style="margin-bottom:10px;">4-week Net Liquidity trend (oldest → newest):
      {% for pt in fed_liquidity.payload.trend_5w %}${{ '%.3f'|format(pt.net_liquidity_bn/1000) }}T ({{ pt.date }}){% if not loop.last %} → {% endif %}{% endfor %}
    </div>
    {% endif %}
    <ul class="reasons">
      {% for r in fedliq_reasons %}<li>{{ r }}</li>{% endfor %}
    </ul>
    <div class="fomo-action" style="margin-top:8px;"><b>High-beta/AI impact:</b> {{ fedliq_calc.impact_high_beta }}</div>
    <div class="fomo-action" style="margin-top:8px;"><b>CSP sizing implication:</b> {{ fedliq_calc.csp_implication }}</div>
    <div class="notes" style="margin-top:8px;">{{ fed_liquidity.notes }}</div>
    {% else %}
    <div class="notes">{{ fed_liquidity.notes }}</div>
    {% endif %}
  </div>
  {% endif %}

  <div class="grid">
    <div class="card">
      <h2>Breadth <span class="status-pill {{ breadth.status }}">{{ breadth.status }}</span></h2>
      {% if breadth.status != 'FAILED' %}
      <div class="metric"><span>% above 20D SMA</span><span class="v">{{ breadth.payload.pct_above_20 }}%</span></div>
      <div class="metric"><span>% above 50D SMA</span><span class="v">{{ breadth.payload.pct_above_50 }}%</span></div>
      <div class="metric"><span>% above 200D SMA</span><span class="v">{{ breadth.payload.pct_above_200 }}%</span></div>
      <div class="metric"><span>Constituent coverage</span><span class="v">{{ breadth.payload.coverage_pct }}%</span></div>
      {% if breadth_deltas.d20 is not none %}
      <div class="metric"><span>Δ20D / Δ50D / Δ200D vs prior</span>
        <span class="v">{{ breadth_deltas.d20 }} / {{ breadth_deltas.d50 }} / {{ breadth_deltas.d200 }}</span></div>
      {% endif %}
      {% else %}
      <div class="notes">{{ breadth.notes }}</div>
      {% endif %}
    </div>

    <div class="card">
      <h2>Volatility <span class="status-pill {{ volatility.status }}">{{ volatility.status }}</span></h2>
      {% if volatility.status != 'FAILED' %}
      {% for label in ['VIX','VIX9D','VIX3M','VVIX'] %}
        {% if volatility.payload[label] %}
        <div class="metric"><span>{{ label }}</span>
          <span class="v">{{ volatility.payload[label].level }}
            ({{ '%+.2f'|format(volatility.payload[label].change_1d) if volatility.payload[label].change_1d is not none else '—' }} 1D)</span></div>
        {% endif %}
      {% endfor %}
      <div class="metric"><span>Term structure</span><span class="v">{{ volatility.payload.curve_state or '—' }}</span></div>
      {% else %}
      <div class="notes">{{ volatility.notes }}</div>
      {% endif %}
    </div>

    <div class="card">
      <h2>Rates <span class="status-pill {{ rates.status }}">{{ rates.status }}</span></h2>
      {% if rates.status != 'FAILED' %}
      <div class="metric"><span>2Y Treasury</span><span class="v">{{ rates.payload.us_2y.level }}%</span></div>
      <div class="metric"><span>10Y Treasury</span><span class="v">{{ rates.payload.us_10y.level }}%</span></div>
      <div class="metric"><span>2s10s spread</span><span class="v">{{ rates.payload.spread_2s10s_bps }} bps</span></div>
      <div class="notes">FedWatch distribution not automated in R1 — <a href="https://www.cmegroup.com/markets/interest-rates/cme-fedwatch-tool.html" style="color:inherit;">official tool</a></div>
      {% else %}
      <div class="notes">{{ rates.notes }}</div>
      {% endif %}
    </div>

    <div class="card">
      <h2>Sector rotation (RSP vs SPY 5D: {{ sectors.payload.rsp_vs_spy_5d if sectors.status != 'FAILED' else '—' }} pts)
        <span class="status-pill {{ sectors.status }}">{{ sectors.status }}</span></h2>
      {% if sectors.status != 'FAILED' %}
      <table>
        <tr><th>#</th><th>Sector</th><th>1D</th><th>5D</th><th>20D</th><th>Rel. vs SPY 20D</th></tr>
        {% for sec in sectors.payload.sectors %}
        <tr>
          <td>{{ sec.rank or '—' }}</td>
          <td>{{ sec.ticker }}{% if sec.is_defensive %} <small>(def.)</small>{% endif %}</td>
          <td class="{{ 'pos' if sec.return_1d and sec.return_1d > 0 else 'neg' }}">{{ sec.return_1d }}</td>
          <td class="{{ 'pos' if sec.return_5d and sec.return_5d > 0 else 'neg' }}">{{ sec.return_5d }}</td>
          <td class="{{ 'pos' if sec.return_20d and sec.return_20d > 0 else 'neg' }}">{{ sec.return_20d }}</td>
          <td class="{{ 'pos' if sec.relative_return_20d_vs_spy and sec.relative_return_20d_vs_spy > 0 else 'neg' }}">{{ sec.relative_return_20d_vs_spy }}</td>
        </tr>
        {% endfor %}
      </table>
      {% else %}
      <div class="notes">{{ sectors.notes }}</div>
      {% endif %}
    </div>

    <div class="card">
      <h2>Consumer Sentiment (UMich) <span class="status-pill {{ consumer_sentiment.status }}">{{ consumer_sentiment.status }}</span></h2>
      {% if consumer_sentiment.status != 'FAILED' %}
      <div class="metric"><span>Index level</span><span class="v">{{ consumer_sentiment.payload.level }}</span></div>
      <div class="metric"><span>MoM change</span>
        <span class="v {{ 'pos' if consumer_sentiment.payload.change_mom and consumer_sentiment.payload.change_mom > 0 else 'neg' }}">{{ '%+.1f'|format(consumer_sentiment.payload.change_mom) if consumer_sentiment.payload.change_mom is not none else '—' }}</span></div>
      <div class="metric"><span>YoY change</span>
        <span class="v {{ 'pos' if consumer_sentiment.payload.change_yoy and consumer_sentiment.payload.change_yoy > 0 else 'neg' }}">{{ '%+.1f'|format(consumer_sentiment.payload.change_yoy) if consumer_sentiment.payload.change_yoy is not none else '—' }}</span></div>
      <div class="notes">As of {{ consumer_sentiment.payload.as_of_month }} — UMich survey, monthly, FRED-delayed ~1 month by source request.</div>
      {% else %}
      <div class="notes">{{ consumer_sentiment.notes }}</div>
      {% endif %}
    </div>
  </div>

  <div class="card" style="margin-bottom:24px;">
    <h2>Why this regime</h2>
    <div class="notes" style="margin-bottom:8px;">Every rule that actually tripped this run, each shown as the value that fired it vs. the threshold that triggered it. No trip = GREEN by default; see the legend above for what each color means.</div>
    <ul class="reasons">
      {% for r in reasons %}<li>{{ r }}</li>{% endfor %}
    </ul>
  </div>

  <div class="card" style="margin-bottom:24px;">
    <h2>CSP candidates
      <span class="status-pill {{ options_chain.status }}">{{ options_chain.status }}</span>
    </h2>
    {% if options_chain.status != 'FAILED' %}
    <div class="notes" style="margin-bottom:10px;">
      One representative strike per ticker, {{ options_chain.payload.dte_window[0] }}-{{ options_chain.payload.dte_window[1] }} DTE window.
      Gates: return ≥ target, spread/OI liquidity, no earnings before expiry. Delta is an estimate (Black-Scholes from implied vol) - not a broker Greek.
      {% if candidates %}{{ candidates.candidate_count }} pass all gates · {{ candidates.watch_only_count }} watch-only (failed a gate){% endif %}
    </div>
    {% if candidates and candidates.candidates %}
    <table>
      <tr><th>Ticker</th><th>Spot</th><th>Strike</th><th>Expiry</th><th>DTE</th><th>Mid</th><th>Ann. return</th><th>Δ (est.)</th><th>Spread%</th><th>OI</th></tr>
      {% for c in candidates.candidates %}
      <tr>
        <td>{{ c.ticker }}</td>
        <td>{{ c.spot }}</td>
        <td>{{ c.pick.strike }}</td>
        <td>{{ c.pick.expiry }}</td>
        <td>{{ c.pick.dte }}</td>
        <td>{{ c.pick.mid }}</td>
        <td class="pos">{{ c.pick.annualized_return_pct }}%</td>
        <td>{{ c.pick.delta_est }}</td>
        <td>{{ c.pick.spread_pct }}</td>
        <td>{{ c.pick.open_interest }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <div class="notes">No candidates passed all gates this run.</div>
    {% endif %}
    {% if candidates and candidates.watch_only %}
    <div class="notes" style="margin-top:12px; font-weight:600;">Watch only (failed a gate):</div>
    <ul class="reasons">
      {% for c in candidates.watch_only %}
      <li>{{ c.ticker }}: {{ c.pick.fail_reasons|join('; ') if c.pick else 'no usable data' }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% else %}
    <div class="notes">{{ options_chain.notes }}</div>
    {% endif %}
  </div>

  <div class="card" style="margin-bottom:24px;">
    <h2>Earnings risk — your positions
      <span class="status-pill {{ earnings.status }}">{{ earnings.status }}</span>
    </h2>
    {% if earnings.status != 'FAILED' %}
    <div class="notes" style="margin-bottom:10px;">Next {{ earnings.payload.lookahead_days }} days · TBD dates are treated as risk, not certainty.</div>
    <table>
      <tr><th>Ticker</th><th>Report date</th><th>When</th><th>Days out</th><th>Confirmed</th></tr>
      {% for ticker, e in earnings.payload.tickers.items() %}
        {% if e.status == 'SCHEDULED' %}
        <tr>
          <td>{{ ticker }}</td>
          <td>{{ e.event.date }}</td>
          <td>{{ e.event.hour }}</td>
          <td>{{ e.event.days_to_event }}</td>
          <td>{{ '✓' if e.event.confirmed else 'TBD' }}</td>
        </tr>
        {% endif %}
      {% endfor %}
    </table>
    {% else %}
    <div class="notes">{{ earnings.notes }}</div>
    {% endif %}
  </div>

  <div class="card" style="margin-bottom:24px;">
    <h2>Market news — your positions
      <span class="status-pill {{ news.status }}">{{ news.status }}</span>
    </h2>
    {% if news.status != 'FAILED' %}
    <div class="notes" style="margin-bottom:10px;">{{ news.payload.ok_count }} tickers with headlines · {{ news.payload.unavailable_count }} unavailable{% if news.payload.unavailable_tickers %} ({{ news.payload.unavailable_tickers|join(', ') }}){% endif %}</div>
    <div class="news-cols">
      {% for ticker, data in news.payload.tickers.items() %}
        {% if data.status == 'OK' and data.headlines %}
        <div class="news-ticker">
          <div class="ticker-label">{{ ticker }}</div>
          {% for h in data.headlines %}
          <div class="headline">
            <a href="{{ h.url }}" target="_blank" rel="noopener">{{ h.headline }}</a>
            <span class="src">— {{ h.source }}{% if h.published_at %} · {{ h.published_at }}{% endif %}</span>
          </div>
          {% endfor %}
        </div>
        {% elif data.status != 'OK' %}
        <div class="news-ticker">
          <div class="ticker-label">{{ ticker }} <span class="unavail">— unavailable ({{ data.reason }})</span></div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
    {% else %}
    <div class="notes">{{ news.notes }}</div>
    {% endif %}
  </div>

  <footer>
    <h2>Data health</h2>
    {% for m in module_health %}
    <div class="health-row">
      <span>{{ m.module }} · {{ m.source }}</span>
      <span><span class="status-pill {{ m.status }}">{{ m.status }}</span> obs {{ m.observation_date or '—' }} · retrieved {{ m.retrieved_at }}</span>
    </div>
    {% endfor %}
    <div class="notes" style="margin-top:10px;">calc_version {{ calc_version }} · run_id {{ run_id }}</div>
  </footer>
</div>
</body>
</html>
